{
  "name": "cap-alert-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Frontend for the CAP v1.2 alerting backend: distribution canvas and routing rule designer.",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
