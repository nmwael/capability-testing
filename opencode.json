      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 25
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "local-qwen3.5-9b-mtp",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "nvidia",
      "effect": "allow"
    }
  ],
  "experimental": {
