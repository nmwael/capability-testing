{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-qwythos-9b-q6k/qwythos-9b-q6k",
  "providers": {
    "local-qwythos-9b-q6k": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Local llama.cpp (qwythos-9b-q6k)",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "qwythos-9b-q6k": {
          "name": "qwythos-9b-q6k",
          "limit": {
            "context": 1048576,
            "output": 16384
          }
        }
      }
    },
    "opencode": {
      "settings": {
        "setCacheKey": false
      }
    },
    "nvidia": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "settings": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
        "nemotron-3-ultra-550b-a55b": {
          "name": "nemotron-3-ultra-550b-a55b (NVIDIA NIM)",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "nemotron-3.5-super-vl-120b-a12b": {
          "name": "nemotron-3.5-super-vl-120b-a12b (NVIDIA NIM)",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "nemotron-3.5-lightning-30b-a3b": {
          "name": "nemotron-3.5-lightning-30b-a3b (NVIDIA NIM)",
          "limit": {
            "context": 1048576,
            "output": 32768
          }
        },
        "llama-3.1-nemotron-70b-instruct": {
          "name": "llama-3.1-nemotron-70b-instruct (NVIDIA NIM)",
          "limit": {
            "context": 131072,
            "output": 4096
          }
        }
      }
    }
  },

  "agents": {
    "architect": {
      "model": "local-qwythos-9b-q6k/qwythos-9b-q6k",
      "request": {
        "body": {
          "temperature": 0.6
        }
      },
      "steps": 500
    },
    "researcher": {
      "model": "local-qwythos-9b-q6k/qwythos-9b-q6k",
      "request": {
        "body": {
          "temperature": 0.6
        }
      },
      "steps": 20
    },
    "reviewer": {
      "model": "local-qwythos-9b-q6k/qwythos-9b-q6k",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 15
    },
    "build": {
      "model": "local-qwythos-9b-q6k/qwythos-9b-q6k",
      "request": {
        "body": {
          "temperature": 0.6
        }
      },
      "steps": 40
    },
    "ui": {
      "model": "local-qwythos-9b-q6k/qwythos-9b-q6k",
      "request": {
        "body": {
          "temperature": 0.6
        }
      },
      "steps": 20
    },
    "artist": {
      "model": "local-qwythos-9b-q6k/qwythos-9b-q6k",
      "request": {
        "body": {
          "temperature": 0.7
        }
      },
      "steps": 15
    },
    "coder": {
      "model": "local-qwythos-9b-q6k/qwythos-9b-q6k",
      "request": {
        "body": {
          "temperature": 0.6
        }
      },
      "steps": 25
    },
    "fact-checker": {
      "model": "local-qwythos-9b-q6k/qwythos-9b-q6k",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 20
    }
  ,
    "cloud_architect": {
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 500
    },
    "cloud_researcher": {
      "model": "nvidia/nemotron-3.5-lightning-30b-a3b",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 20
    },
    "cloud_reviewer": {
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 15
    },
    "cloud_build": {
      "model": "nvidia/llama-3.1-nemotron-70b-instruct",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "steps": 40
    },
    "cloud_ui": {
      "model": "nvidia/nemotron-3.5-super-vl-120b-a12b",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "steps": 20
    },
    "cloud_artist": {
      "model": "nvidia/nemotron-3.5-super-vl-120b-a12b",
      "request": {
        "body": {
          "temperature": 0.3
        }
      },
      "steps": 15
    },
    "cloud_coder": {
      "model": "nvidia/nemotron-3.5-super-vl-120b-a12b",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 25
    },
    "cloud_fact-checker": {
      "model": "nvidia/nemotron-3.5-lightning-30b-a3b",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 20
    }
  },
    

  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "policies": [
    {
      "action": "provider.use",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "provider.use",
      "resource": "local-qwythos-9b-q6k",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "opencode",
      "effect": "allow"
    },
    {
      "action": "provider.use",
      "resource": "nvidia",
      "effect": "allow"
    }
  ],
  "experimental": {
    "subagent_depth": 3
  }
}
