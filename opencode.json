{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
  "providers": {
    "local-qwen3.5-9b-mtp": {
      "name": "Bifrost (local qwen3.5-9b-mtp)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8082/v1"
      },
      "headers": {
        "x-bf-passthrough-extra-params": "true"
      },
      "models": {
        "qwen3.5-9b-mtp": {
          "name": "qwen3.5-9b-mtp (unpinned fallback)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.5-9b-mtp-s0": {
          "name": "qwen3.5-9b-mtp - Slot 0 (coder)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "qwen3.5-9b-mtp-s1": {
          "name": "qwen3.5-9b-mtp - Slot 1 (architect + non-coder roles)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        }
      }
    },
    "opencode": {
      "settings": {
        "setCacheKey": false
      }
    }
  },
  "agents": {
    "architect": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "steps": 150,
      "temperature": 0.1,
      "reasoning": {
        "effort": "medium",
        "max_tokens": 2048
      }
    },
    "researcher": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "steps": 60,
      "temperature": 0.1,
      "reasoning": {
        "effort": "low",
        "max_tokens": 512
      }
    },
    "reviewer": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "steps": 30,
      "temperature": 0.1,
      "reasoning": {
        "effort": "medium",
        "max_tokens": 1024
      }
    },
    "fact-checker": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "steps": 60,
      "temperature": 0.1,
      "reasoning": {
        "effort": "medium",
        "max_tokens": 1024
      }
    },
    "build": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "steps": 80,
      "temperature": 0.2,
      "reasoning": {
        "effort": "minimal",
        "max_tokens": 256
      }
    },
    "ui": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "steps": 60,
      "temperature": 0.2,
      "reasoning": {
        "effort": "low",
        "max_tokens": 512
      }
    },
    "artist": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "steps": 40,
      "temperature": 0.3,
      "reasoning": {
        "effort": "low",
        "max_tokens": 512
      }
    },
    "coder": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s0",
      "steps": 120,
      "temperature": 0.1,
      "reasoning": {
        "effort": "medium",
        "max_tokens": 2048
      }
    },
    "title": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "reasoning": {
        "effort": "minimal",
        "max_tokens": 128
      }
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "lsp": true,
  "experimental": {
    "subagent_depth": 2,
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "local-qwen3.5-9b-mtp",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "opencode",
        "effect": "allow"
      }
    ]
  }
}
