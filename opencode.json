{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-granite-4.2-3b/granite-4.2-3b-s0",
  "providers": {
    "local-granite-4.2-3b": {
      "name": "Bifrost (local granite-4.2-3b)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8082/v1"
      },
      "headers": {
        "x-bf-passthrough-extra-params": "true"
      },
      "models": {
        "granite-4.2-3b": {
          "name": "granite-4.2-3b (unpinned fallback)",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "granite-4.2-3b-s0": {
          "name": "granite-4.2-3b - Slot 0",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    },
    "local-qwen3.5-9b-mtp": {
      "name": "Bifrost (local qwen3.5-9b-mtp)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8082/v1"
      },
      "headers": {
        "x-bf-passthrough-extra-params": "true"
      },
      "models": {
        "qwen3.5-9b-mtp": {
          "name": "qwen3.5-9b-mtp (unpinned fallback)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.5-9b-mtp-s0": {
          "name": "qwen3.5-9b-mtp - Slot 0",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "opencode": {
      "settings": {
        "setCacheKey": false
      }
    }
  },
  "agents": {
    "architect": {
      "model": "local-granite-4.2-3b/granite-4.2-3b-s0",
      "steps": 150,
      "request": {
        "body": {
          "temperature": 0.1
        }
      }
    },
    "researcher": {
      "model": "local-granite-4.2-3b/granite-4.2-3b-s0",
      "steps": 60,
      "request": {
        "body": {
          "temperature": 0.1
        }
      }
    },
    "reviewer": {
      "model": "local-granite-4.2-3b/granite-4.2-3b-s0",
      "steps": 60,
      "request": {
        "body": {
          "temperature": 0.1
        }
      }
    },
    "fact-checker": {
      "model": "local-granite-4.2-3b/granite-4.2-3b-s0",
      "steps": 40,
      "request": {
        "body": {
          "temperature": 0.1
        }
      }
    },
    "build": {
      "model": "local-granite-4.2-3b/granite-4.2-3b-s0",
      "steps": 80,
      "request": {
        "body": {
          "temperature": 0.2
        }
      }
    },
    "ui": {
      "model": "local-granite-4.2-3b/granite-4.2-3b-s0",
      "steps": 60,
      "request": {
        "body": {
          "temperature": 0.2
        }
      }
    },
    "artist": {
      "model": "local-granite-4.2-3b/granite-4.2-3b-s0",
      "steps": 40,
      "request": {
        "body": {
          "temperature": 0.3
        }
      }
    },
    "coder": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s0",
      "steps": 120,
      "request": {
        "body": {
          "temperature": 0.1
        }
      }
    },
    "title": {
      "model": "local-granite-4.2-3b/granite-4.2-3b-s0"
    }
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],
  "lsp": true,
  "experimental": {
    "subagent_depth": 2,
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "local-granite-4.2-3b",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "local-qwen3.5-9b-mtp",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "opencode",
        "effect": "allow"
      }
    ]
  }
}
