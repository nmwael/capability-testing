            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "opencode": {
      "settings": {
        "setCacheKey": false
      }
    },
    "nvidia": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "NVIDIA NIM",
      "settings": {
        "baseURL": "https://integrate.api.nvidia.com/v1"
      },
      "models": {
