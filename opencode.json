{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-phi-4-mini/phi-4-mini-s0",
  "small_model": "local-phi-4-mini/phi-4-mini-s0",
  "provider": {
    "local-phi-4-mini": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bifrost (local phi-4-mini)",
      "options": {
        "baseURL": "http://127.0.0.1:8082/v1",
        "headers": {
          "x-bf-passthrough-extra-params": "true"
        }
      },
      "models": {
        "phi-4-mini": {
          "name": "phi-4-mini (unpinned fallback)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "phi-4-mini-s0": {
          "name": "phi-4-mini - Slot 0",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "local-qwen3.5-9b-mtp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bifrost (local qwen3.5-9b-mtp)",
      "options": {
        "baseURL": "http://127.0.0.1:8082/v1",
        "headers": {
          "x-bf-passthrough-extra-params": "true"
        }
      },
      "models": {
        "qwen3.5-9b-mtp": {
          "name": "qwen3.5-9b-mtp (unpinned fallback)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3.5-9b-mtp-s0": {
          "name": "qwen3.5-9b-mtp - Slot 0",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "opencode": {
      "options": {
        "setCacheKey": false
      }
    }
  },
"agent": {
    "architect": {
      "description": "Plans work, delegates to specialists, coordinates dependencies, and integrates results.",
      "model": "local-phi-4-mini/phi-4-mini-s0",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "todowrite": "allow",
        "question": "allow"
          }
    },
    "researcher": {
      "model": "local-phi-4-mini/phi-4-mini-s0",
      "permission": {
        "read": "allow",
        "webfetch": "allow",
        "websearch": "allow"
      }
    },
    "reviewer": {
      "model": "local-phi-4-mini/phi-4-mini-s0",
      "permission": {
        "read": "allow",
        "lsp": "allow"
      }
    },
    "build": {
      "model": "local-phi-4-mini/phi-4-mini-s0",
      "permission": {
        "read": "allow",
        "bash": "ask"
      }
    },
    "ui": {
      "model": "local-phi-4-mini/phi-4-mini-s0",
      "permission": {
        "read": "allow",
        "edit": "allow"
      }
    },
    "artist": {
      "model": "local-phi-4-mini/phi-4-mini-s0",
      "permission": {
        "read": "allow",
        "webfetch": "allow"
      }
    },
    "coder": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s0",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "bash": "ask",
        "glob": "allow",
        "grep": "allow",
        "lsp": "allow"
      }
    }
  }
  ,
  "enabled_providers": [
    "local-phi-4-mini",
    "local-qwen3.5-9b-mtp",
    "opencode"
  ],
  "subagent_depth": 2,
  "server": {
    "port": 4096
  },
  "limit": {
    "context": 32768
  }
}
