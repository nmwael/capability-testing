{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
  "providers": {
    "local-qwen3.5-9b-mtp": {
      "package": "aisdk:@ai-sdk/openai-compatible",
      "name": "Bifrost (local qwen3.5-9b-mtp)",
      "settings": {
        "baseURL": "http://127.0.0.1:8082/v1"
      },
      "headers": {
        "x-bf-passthrough-extra-params": "true"
      },
      "models": {
        "qwen3.5-9b-mtp": {
          "name": "qwen3.5-9b-mtp (unpinned fallback)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "qwen3.5-9b-mtp-s0": {
          "name": "qwen3.5-9b-mtp - Slot 0",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "qwen3.5-9b-mtp-s1": {
          "name": "qwen3.5-9b-mtp - Slot 1",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "opencode": {
      "settings": {
        "setCacheKey": false
      }
    }

  },
  "agents": {
    "architect": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 500
    },
    "researcher": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 20
    },
    "reviewer": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 15
    },
    "build": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "steps": 40
    },
    "ui": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "steps": 20
    },
    "artist": {
      "model": "local-qwen3.5-9b-mtp/qwen3.5-9b-mtp-s1",
      "request": {
        "body": {
          "temperature": 0.3
        }
      },
      "steps": 15
    },
    "coder": {
