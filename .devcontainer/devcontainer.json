{
  "name": "capability-testing",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZsh": false,
      "username": "vscode",
      "uid": "1000",
      "gid": "1000"
    },
    "ghcr.io/nmwael/agentic-devcontainer-feature/llama-server:1.0.5": {},
    "ghcr.io/nmwael/agentic-devcontainer-feature/gpu-bridge:1.0.1": {},
    "ghcr.io/nmwael/agentic-devcontainer-feature/bifrost-gateway:1.1.3": {},
    "ghcr.io/nmwael/agentic-devcontainer-feature/models:1.4.0": {},
    "ghcr.io/nmwael/agentic-devcontainer-feature/opencode-agents:1.2.3": {},
    "ghcr.io/devcontainers-extra/features/opencode:1.0.0": {},
    "ghcr.io/tailscale/codespace/tailscale:1.0.8": {},
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1.0.8": {
      "packages": "gh,jq,ripgrep,shfmt,shellcheck,bats,python3,python3-pip,python3-venv"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "installMaven": true
    },
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    },
    "ghcr.io/devcontainers-extra/features/devcontainers-cli:1": {}
  },
  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/common-utils:2",
    "ghcr.io/nmwael/agentic-devcontainer-feature/llama-server:1.0.5",
    "ghcr.io/nmwael/agentic-devcontainer-feature/gpu-bridge:1.0.1",
    "ghcr.io/nmwael/agentic-devcontainer-feature/models:1.4.0",
    "ghcr.io/nmwael/agentic-devcontainer-feature/bifrost-gateway:1.1.3",
    "ghcr.io/nmwael/agentic-devcontainer-feature/opencode-agents:1.2.3",
    "ghcr.io/devcontainers-extra/features/opencode:1.0.0",
    "ghcr.io/tailscale/codespace/tailscale:1.0.8",
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1.0.8",
    "ghcr.io/devcontainers/features/java:1",
    "ghcr.io/devcontainers/features/docker-in-docker:4",
    "ghcr.io/devcontainers/features/node:2",
    "ghcr.io/devcontainers-extra/features/devcontainers-cli:1"
  ],
  "privileged": true,
  "capAdd": [
    "SYS_PTRACE"
  ],
  "securityOpt": [
    "seccomp:unconfined"
  ],
  "hostRequirements": {
    "gpu": true
  },
  "runArgs": [
    "--shm-size=2g",
    "--device=/dev/dxg",
    "--volume=/usr/lib/wsl/lib:/usr/lib/wsl/lib:ro",
    "--volume=/usr/lib/wsl/drivers:/usr/lib/wsl/drivers:ro"
  ],
  "forwardPorts": [
    8082,
    8089,
    8090,
    4096
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-vscode.cpptools",
        "redhat.extension-pack-for-java",
        "esbenore.platform-settings",
        "eammatthews.cmake-tools"
      ]
    }
  },
  "containerEnv": {
    "LD_LIBRARY_PATH": "/usr/lib/wsl/lib:/opt/llama-server:/usr/local/cuda/compat:/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/local/cuda/lib64",
    "TS_AUTHKEY": "${localEnv:TS_AUTHKEY}",
    "TS_HOSTNAME": "${localEnv:TS_HOSTNAME}",
    "GOOGLE_API_KEY": "${localEnv:GOOGLE_API_KEY}",
    "NVIDIA_API_KEY": "${localEnv:NVIDIA_API_KEY}",
    "SKIP_LLAMA_START": "${localEnv:SKIP_LLAMA_START}"
  },
  "postCreateCommand": "bash scripts/post-create.sh",
  "postStartCommand": "bash scripts/auto-startup.sh"
}
