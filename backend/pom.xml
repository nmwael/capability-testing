<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>capability-testing-backend</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>publication</module>
    <module>alerting</module>
    <module>common</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <pitest.version>1.30.1</pitest.version>
    <quarkus.platform.version>3.15.1</quarkus.platform.version>
    <archunit.version>1.2.0</archunit.version>
    <quarkus-cucumber.version>1.3.0</quarkus-cucumber.version>
    <drools.version>10.2.0</drools.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus.platform</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.drools</groupId>
        <artifactId>drools-bom</artifactId>
        <version>${drools.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.quarkiverse.cucumber</groupId>
        <artifactId>quarkus-cucumber</artifactId>
        <version>${quarkus-cucumber.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- Surefire's default includes are **/*Test|*Tests|Test*|*TestCase, which
           silently skips the capability integration tests named *IT. Pull them
           into `mvn test` so CI actually executes what capabilities.yml verifies. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
        <configuration>
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*IT.java</include>
          </includes>
          <systemPropertyVariables>
            <!-- BDD specs under features/ may carry @todo: behaviour the retrofit has
                 not implemented yet. Those scenarios stay out of the default run —
                 implementing one means deleting the tag, never editing this filter. -->
            <cucumber.filter.tags>not @todo</cucumber.filter.tags>
            <!-- quarkus-cucumber drives Cucumber's core runtime directly and bridges
                 it to JUnit with parameteriser-named dynamic tests, so there is no
                 JUnit Platform engine to honour a naming strategy. The extension
                 does read system properties, so ask Cucumber itself for a JUnit XML:
                 its formatter writes the real Scenario names, which surefire's getTests()
                 identifiers cannot carry. -->
            <cucumber.plugin>junit:target/cucumber-junit.xml</cucumber.plugin>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>io.quarkus.platform</groupId>
          <artifactId>quarkus-maven-plugin</artifactId>
          <version>${quarkus.platform.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!-- Mutation testing: `mvn -Ppit test-compile org.pitest:pitest-maven:mutationCoverage`.
       Off by default - the default build must stay fast, and PIT's per-mutation
       test reruns are minutes per module.

       It answers the question line coverage cannot: whether the tests assert
       anything. A class can read as covered and still be wrong, because a method
       that runs but whose outputs nobody checks leaves every mutation of those
       outputs alive. PIT reports each surviving mutation, which is the list of
       missing tests. -->
  <profiles>
    <profile>
      <id>pit</id>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>org.pitest</groupId>
              <artifactId>pitest-maven</artifactId>
              <version>${pitest.version}</version>
              <configuration>
                <targetClasses>com.example*</targetClasses>
                <!-- What PIT can and cannot replay. The Cucumber runner needs
                     Cucumber's own JUnit plugin, which is not on PIT's path, and
                     a @QuarkusTest boots its app in a classloader PIT's coverage
                     recorder cannot see: including the ITs reported 0% line
                     coverage on classes JaCoCo proves they exercise, so their
                     mutants would read as untested rather than merely weak.
                     Excluding both keeps the numbers honest and leaves PIT the
                     plain JUnit tests (common; alerting's arch and ruleset
                     tests). publication then has no eligible test at all - PIT
                     reports zero mutations for it rather than a fake gap. -->
                <excludedTestClasses>
                  <excludedTestClass>*CucumberTest</excludedTestClass>
                  <excludedTestClass>*IT</excludedTestClass>
                </excludedTestClasses>
                <outputDirectory>${project.build.directory}/pit-reports</outputDirectory>
                <outputFormats>XML</outputFormats>
                <timestampedReports>false</timestampedReports>
                <failWhenNoMutations>false</failWhenNoMutations>
                <threads>1</threads>
              </configuration>
              <dependencies>
                <dependency>
                  <groupId>org.pitest</groupId>
                  <artifactId>pitest-junit5-plugin</artifactId>
                  <version>1.2.3</version>
                </dependency>
              </dependencies>
            </plugin>
          </plugins>
        </pluginManagement>
        <plugins>
          <plugin>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-maven</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
